# ─── NASA FIRMS ────────────────────────────────────────────────────────────────
# API Key gratuita en: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=your_firms_map_key_here

# ─── Copernicus Climate Data Store (ERA5) ──────────────────────────────────────
# Registro gratuito en: https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_cds_api_key_here

# ─── PostGIS / PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=wildfire_risk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── MinIO (S3 compatible para GeoTIFFs) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ─── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Obtenlo en: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_RECIPIENT_NUMBER=51987654321

# ─── Telegram Bot (opcional) ──────────────────────────────────────────────────
# Obtén el token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
